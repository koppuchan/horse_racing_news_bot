# Google Gemini API key (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WordPress site URL (must have HTTPS)
WP_BASE_URL=https://your-site.com

# WordPress login username
WP_USERNAME=your-wp-username

# WordPress Application Password
# Generate: WP Admin > Users > Profile > Application Passwords > Add New
# NOTE: This is NOT the regular login password — it is a separate app password.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
